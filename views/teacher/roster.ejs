<%- include('../partials/head', { title: '报名名单' }) %>
<%- include('../partials/teacher-sidebar', { active: 'activities' }) %>
    <div class="page-head">
      <h2>报名名单</h2>
      <a class="btn btn-secondary" href="/teacher/activities">返回活动管理</a>
    </div>
    <div class="card">
      <div class="page-head">
        <h3><%= activity.title %></h3>
        <span class="meta">正式报名：<%= registeredCount %> / <%= activity.max_participants %>；候补：<%= waitingCount %></span>
      </div>
      <p class="meta">活动时间：<%= activity.time %></p>
      <p class="meta">活动地点：<%= activity.location %></p>
      <% if (activity.needs_review) { %>
        <p class="meta">参加条件：<%= activity.requirement || '（未填写）' %>（报名需老师确认）</p>
      <% } %>
      <% if (students.length === 0) { %>
        <div class="empty-state">暂无学生报名</div>
      <% } else { %>
        <table class="table">
          <thead>
            <tr><th>序号</th><th>学生用户名</th><th>报名时间</th><th>状态</th><th>操作</th></tr>
          </thead>
          <tbody>
            <% students.forEach((s, i) => { %>
              <tr>
                <td data-label="序号"><%= i + 1 %></td>
                <td data-label="学生用户名"><%= s.username %></td>
                <td data-label="报名时间"><%= s.created_at %></td>
                <td data-label="状态"><span class="badge badge-<%= s.status_label.color %>"><%= s.status_label.label %></span></td>
                <td data-label="操作">
                  <% if (s.status === 'pending') { %>
                    <form class="inline-form" action="/teacher/activities/<%= activity.id %>/review" method="POST">
                      <input type="hidden" name="registration_id" value="<%= s.registration_id %>">
                      <input type="hidden" name="action" value="approve">
                      <button class="btn btn-primary btn-sm" type="submit">通过</button>
                    </form>
                    <form class="inline-form" action="/teacher/activities/<%= activity.id %>/review" method="POST">
                      <input type="hidden" name="registration_id" value="<%= s.registration_id %>">
                      <input type="hidden" name="action" value="reject">
                      <button class="btn btn-danger btn-sm" type="submit">未通过</button>
                    </form>
                  <% } else { %>
                    <span class="meta">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
