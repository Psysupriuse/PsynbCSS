<%- include('../partials/head', { title: mode === 'edit' ? '编辑活动' : '新增活动' }) %>
<%- include('../partials/teacher-sidebar', { active: 'activities' }) %>
    <div class="page-head"><h2><%= mode === 'edit' ? '编辑活动' : '新增活动' %></h2></div>
    <form action="<%= mode === 'edit' ? '/teacher/activities/' + activity.id + '/edit' : '/teacher/activities/new' %>" method="POST" class="card form-card">
      <div class="form-group">
        <label class="form-label" for="title">活动标题 <span class="required">*</span></label>
        <input class="form-input" type="text" id="title" name="title" value="<%= activity.title || '' %>" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="time">活动时间 <span class="required">*</span></label>
        <input class="form-input" type="text" id="time" name="time" value="<%= activity.time || '' %>" placeholder="格式：YYYY-MM-DD HH:MM，如 2026-10-15 19:00" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="location">活动地点 <span class="required">*</span></label>
        <input class="form-input" type="text" id="location" name="location" value="<%= activity.location || '' %>" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="description">活动简介 <span class="required">*</span></label>
        <textarea class="form-input" id="description" name="description" rows="4" required><%= activity.description || '' %></textarea>
      </div>
      <div class="form-group">
        <label class="form-label" for="max_participants">最大报名人数 <span class="required">*</span></label>
        <input class="form-input" type="number" id="max_participants" name="max_participants" value="<%= activity.max_participants || '' %>" min="1" required>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">保存</button>
        <a class="btn btn-secondary" href="/teacher/activities">取消</a>
      </div>
    </form>
  </main>
</div>
</body>
</html>
