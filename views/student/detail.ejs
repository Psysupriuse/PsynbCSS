<%- include('../partials/head', { title: '活动详情' }) %>
<%- include('../partials/student-nav', { active: 'index' }) %>
<main class="container">
  <%- include('../partials/flash') %>
  <div class="card">
    <div class="page-head">
      <h2><%= activity.title %></h2>
      <span class="badge badge-<%= activity.status.color %>"><%= activity.status.label %></span>
    </div>
    <p class="meta">活动时间：<%= activity.time %></p>
    <p class="meta">活动地点：<%= activity.location %></p>
    <p class="meta">主办教师：<%= activity.teacher_name %></p>
    <p class="meta">最大报名人数：<%= activity.max_participants %> 人</p>
    <p class="meta">已报名：<%= activity.registered_count %> 人</p>
    <h3>活动介绍</h3>
    <p><%= activity.description %></p>
    <div class="form-actions">
      <% if (activity.registered_by_me) { %>
        <button class="btn btn-secondary" disabled>已报名，不可重复报名</button>
      <% } else if (activity.status.key === 'ended') { %>
        <button class="btn btn-secondary" disabled>活动已结束</button>
      <% } else if (activity.status.key === 'full') { %>
        <button class="btn btn-secondary" disabled>报名人数已满</button>
      <% } else { %>
        <form action="/student/activities/<%= activity.id %>/register" method="POST">
          <button class="btn btn-primary" type="submit">立即报名</button>
        </form>
      <% } %>
      <a class="btn btn-secondary" href="/student">返回列表</a>
    </div>
  </div>
</main>
</body>
</html>
