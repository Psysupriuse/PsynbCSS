<%- include('../partials/head', { title: '活动详情' }) %>
<%- include('../partials/student-nav', { active: 'index' }) %>
<main class="container">
  <%- include('../partials/flash') %>
  <div class="card">
    <div class="page-head">
      <h2><%= activity.title %></h2>
      <span class="badge badge-<%= activity.status.color %>"><%= activity.status.label %></span>
    </div>
    <p class="meta">
      <span class="badge badge-info"><%= activity.category %></span>
      <span class="meta-strong">活动时间：<%= activity.time %></span>
    </p>
    <p class="meta">活动地点：<%= activity.location %></p>
    <p class="meta">主办教师：<%= activity.teacher_name %></p>
    <p class="meta">最大报名人数：<%= activity.max_participants %> 人</p>
    <p class="meta-strong">已报名（含待确认）：<%= activity.registered_count %> 人</p>
    <% if (activity.waiting_count) { %>
      <p class="meta">候补：<%= activity.waiting_count %> 人</p>
    <% } %>
    <% if (activity.needs_review) { %>
      <p class="meta">参加条件：<%= activity.requirement || '（未填写）' %></p>
      <p class="meta">说明：报名后需老师确认，确认结果可在「我的报名」查看，也会在「消息」中通知。</p>
    <% } %>
    <h3>活动介绍</h3>
    <p><%= activity.description %></p>

    <% const s = activity.myRecord ? activity.myRecord.status : null; %>
    <div class="form-actions">
      <% if (s === 'pending') { %>
        <span class="badge badge-warning">待确认</span>
        <form class="js-submitting" action="/student/activities/<%= activity.id %>/cancel" method="POST">
          <button class="btn btn-secondary" type="submit">取消报名</button>
        </form>
      <% } else if (s === 'approved') { %>
        <span class="badge badge-success">已通过</span>
        <form class="js-submitting" action="/student/activities/<%= activity.id %>/cancel" method="POST">
          <button class="btn btn-secondary" type="submit">取消报名</button>
        </form>
      <% } else if (s === 'waiting') { %>
        <span class="badge badge-info">候补中</span>
        <form class="js-submitting" action="/student/activities/<%= activity.id %>/leave-waitlist" method="POST">
          <button class="btn btn-secondary" type="submit">退出候补</button>
        </form>
      <% } else { %>
        <% if (s === 'rejected') { %><span class="badge badge-danger">未通过</span><% } %>
        <% if (s === 'cancelled') { %><span class="badge badge-secondary">已取消</span><% } %>
        <% if (activity.status.key === 'ended') { %>
          <button class="btn btn-secondary" disabled>活动已结束</button>
        <% } else if (activity.status.key === 'full') { %>
          <form class="js-submitting" action="/student/activities/<%= activity.id %>/waitlist" method="POST">
            <button class="btn btn-primary" type="submit">加入候补</button>
          </form>
        <% } else { %>
          <form class="js-submitting" action="/student/activities/<%= activity.id %>/register" method="POST">
            <button class="btn btn-primary" type="submit"><%= s === 'rejected' ? '重新报名' : '立即报名' %></button>
          </form>
        <% } %>
      <% } %>
      <a class="btn btn-secondary" href="/student">返回列表</a>
    </div>
  </div>
</main>
<script src="/js/main.js"></script>
</body>
</html>
