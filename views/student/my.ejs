<%- include('../partials/head', { title: '我的报名' }) %>
<%- include('../partials/student-nav', { active: 'my' }) %>
<main class="container">
  <%- include('../partials/flash') %>
  <div class="page-head"><h2>我的报名</h2></div>
  <% if (rows.length === 0) { %>
    <div class="empty-state">还没有报名任何活动，去首页看看吧</div>
  <% } else { %>
    <table class="table">
      <thead>
        <tr><th>活动名称</th><th>活动时间</th><th>报名时间</th><th>报名状态</th><th>操作</th></tr>
      </thead>
      <tbody>
        <% rows.forEach(a => { %>
          <tr>
            <td data-label="活动名称"><%= a.title %></td>
            <td data-label="活动时间"><%= a.time %></td>
            <td data-label="报名时间"><%= a.registered_at %></td>
            <td data-label="报名状态"><span class="badge badge-<%= a.reg_status_label.color %>"><%= a.reg_status_label.label %></span></td>
            <td data-label="操作">
              <a class="btn btn-secondary btn-sm" href="/student/activities/<%= a.id %>">查看详情</a>
              <% if (a.reg_status === 'pending' || a.reg_status === 'approved') { %>
                <form class="inline-form js-submitting" action="/student/activities/<%= a.id %>/cancel" method="POST">
                  <button class="btn btn-danger btn-sm" type="submit">取消报名</button>
                </form>
              <% } else if (a.reg_status === 'waiting') { %>
                <form class="inline-form js-submitting" action="/student/activities/<%= a.id %>/leave-waitlist" method="POST">
                  <button class="btn btn-danger btn-sm" type="submit">退出候补</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>
<script src="/js/main.js"></script>
</body>
</html>
