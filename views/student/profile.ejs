<%- include('../partials/head', { title: '个人中心' }) %>
<%- include('../partials/student-nav', { active: 'profile' }) %>
<main class="container">
  <%- include('../partials/flash') %>
  <div class="card form-card">
    <div class="page-head"><h2>个人中心</h2></div>
    <p class="meta">用户名：<%= currentUser.username %></p>
    <p class="meta">角色：学生</p>
    <h3>修改密码</h3>
    <form action="/student/profile" method="POST">
      <div class="form-group">
        <label class="form-label" for="current">当前密码 <span class="required">*</span></label>
        <input class="form-input" type="password" id="current" name="current" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="password">新密码 <span class="required">*</span></label>
        <input class="form-input" type="password" id="password" name="password" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="confirm">确认新密码 <span class="required">*</span></label>
        <input class="form-input" type="password" id="confirm" name="confirm" required>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">修改密码</button>
      </div>
    </form>
    <form action="/logout" method="POST" class="inline-form">
      <button class="btn btn-secondary" type="submit">退出登录</button>
    </form>
  </div>
</main>
</body>
</html>
